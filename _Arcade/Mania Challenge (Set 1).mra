<misterromdescription>
    <name>Mania Challenge (Set 1)</name>
    <setname>maniach</setname>
    <rbf>maniach</rbf>
    <mameversion>0283</mameversion>
    <year>1986</year>
    <manufacturer>Technos Japan (Taito America License)</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Vertical (CCW)</rotation>
    <region>US</region>
    <platform>Mat Mania Hardware</platform>
    <category>Sports</category>
    <catver>Sports / Wrestling</catver>

    <switches default="20,f0">
        <dip name="Coin A" bits="0,1" ids="1 Coin/1 Credit,1 Coin/2 Credits,1 Coin/3 Credits,2 Coins/1 Credit"/>
        <dip name="Coin B" bits="2,3" ids="1 Coin/1 Credit,1 Coin/2 Credits,1 Coin/3 Credits,2 Coins/1 Credit"/>
        <dip name="Demo Sounds" bits="4" ids="On,Off"/>
        <dip name="Cabinet" bits="5" ids="Cocktail,Upright"/>
        <dip name="Service Mode" bits="6" ids="Off,On"/>
        <dip name="Difficulty" bits="8,9" ids="Easy,Medium,Hard,Hardest"/>
        <dip name="Tournament Time" bits="10,11" ids="2:36,2:30,2:24,2:12"/>
    </switches>

    <buttons names="Punch,Kick,-,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,R" count="6"/>

    <rom index="1">
        <part>00</part>
    </rom>

    <rom index="0" zip="maniach.zip" md5="none">
        <!-- maincpu - starts at 0x00000 -->
        <part name="mc-mb2.bin" crc="a6da1ba8"/>
        <part name="mc-ma2.bin" crc="84583323"/>
        <part name="mc-m92.bin" crc="e209a500"/>

        <!-- audiocpu - starts at 0x0C000 -->
        <part name="mc-m50.bin" crc="ba415d68"/>
        <part name="mc-m40.bin" crc="2a217ed0"/>
        <part name="mc-m30.bin" crc="95af1723"/>

        <!-- mcu - starts at 0x18000 -->
        <part name="01" crc="00c7f80c"/>

        <!-- chars - starts at 0x18800 -->
        <part name="mc-m60.bin" crc="1cdbb117"/>
        <part name="mc-m70.bin" crc="553f0780"/>
        <part name="mc-m80.bin" crc="9392ecb7"/>

        <!-- tiles - starts at 0x1E800 -->
        <part name="mc-m01.bin" crc="da558e4d"/>
        <part name="mc-m10.bin" crc="619a02f8"/>
        <part name="mc-m20.bin" crc="a617c6c1"/>

        <!-- sprites - starts at 0x36800 -->
        <part name="mc-mc0.bin" crc="133d644f"/>
        <part name="mc-md0.bin" crc="e387b036"/>
        <part name="mc-me0.bin" crc="b36b1283"/>
