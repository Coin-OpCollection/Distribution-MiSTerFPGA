<misterromdescription>
    <name>Tumble Pop (World)</name>
    <setname>tumblep</setname>
    <rbf>tumblep_mister</rbf>
    <mameversion>0283</mameversion>
    <year>1991</year>
    <manufacturer>Data East Corporation</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Horizontal</rotation>
    <region>World</region>
    <platform>DECO DE-0343-X Hardware</platform>
    <category>Platform</category>
    <catver>Platform / Run Jump</catver>

    <switches default="FF,FE">
        <!-- DSW1 -->
        <dip name="Coin Credit" bits="0" ids="2 Coins,1 Coin"/>
        <dip name="Screen Rotation" bits="1" ids="On,Off"/>
        <dip name="Coin Right" bits="2,4" ids="3 Coins/1 Credit,1 Coin/4 Credits,1 Coin/6 Credits,1 Coin/2 Credits,2 Coins/1 Credit,3 Coins/1 Credit,1 Coin/5 Credits,1 Coin/1 Credit"/>
        <dip name="Coin Left" bits="5,7" ids="3 Coins/1 Credit,1 Coin/4 Credits,1 Coin/6 Credits,1 Coin/2 Credits,2 Coins/1 Credit,3 Coins/1 Credit,1 Coin/5 Credits,1 Coin/1 Credit"/>
        <!-- DSW2 -->
        <dip name="Attract Mode Sound" bits="8" ids="On,Off"/>
        <dip name="Continue Mode" bits="9" ids="No,Yes"/>
        <dip name="Game Difficulty" bits="12,13" ids="Hardest,Easy,Hard,Normal"/>
        <dip name="No. of Lives" bits="14,15" ids="2,4,1,3"/>
    </switches>

    <buttons names="Weapon,Jump,-,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,-" count="6"/>

    <rom index="1">
        <part>00</part>
    </rom>

    <rom index="0" zip="tumblep.zip" md5="None" address="0x30000000">
        <!-- maincpu - starts at 0x000000 -->
        <interleave output="16">
            <part name="hl00-1.f12" crc="fd697c1b" map="10"/>
            <part name="hl01-1.f13" crc="d5a62a3f" map="01"/>
        </interleave>

        <!-- audiocpu - starts at 0x080000 -->
        <part name="hl02-.f16" crc="a5cab888"/>

        <!-- oki - starts at 0x090000 -->
        <part name="hl03-.j15" crc="01b81da0"/>

        <!-- tiles - starts at 0x0B0000 -->
        <interleave output="32">
            <part name="map-02.rom" crc="dfceaa26" map="0012" offset="0x00000" length="0x40000"/>
            <part name="map-02.rom" crc="dfceaa26" map="1200" offset="0x40000" length="0x40000"/>
        </interleave>

        <!-- sprites - starts at 0x130000 -->
        <interleave output="32">
            <part name="map-00.rom" crc="8c879cfe" map="0021"/>
            <part name="map-01.rom" crc="e81ffa09" map="2100"/>
        </interleave>
        <!-- Total 0x230000 bytes -->
    </rom>
</misterromdescription>
