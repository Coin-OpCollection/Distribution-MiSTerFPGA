<misterromdescription>
    <name>Snow Bros. - Nick &amp; Tom (Japan)</name>
    <setname>snowbrosj</setname>
    <rbf>snowbros_mister</rbf>
    <mameversion>0281</mameversion>
    <year>1990</year>
    <manufacturer>Toaplan</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Horizontal</rotation>
    <region>Japan</region>
    <platform>Snow Bros. Platform</platform>
    <category>Platform</category>
    <catver>Platform / Run Jump</catver>

    <switches default="BF,FF">
        <!-- DSW1 -->
        <dip name="Screen Flip" bits="1" ids="On,Off"/>
        <dip name="Test Mode" bits="2" ids="On,Off"/>
        <dip name="Advertise Sound" bits="3" ids="Off,On"/>
        <dip name="Coin A" bits="4,5" ids="2/3,2/1,1/2,1/1"/>
        <dip name="Coin B" bits="6,7" ids="2/3,2/1,1/2,1/1"/>
        <!-- DSW2 -->
        <dip name="Game Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Extend" bits="10,11" ids="None,100k/200k(E),200k,100k"/>
        <dip name="Hero Counts" bits="12,13" ids="2,4,1,3"/>
        <dip name="Invulnerability" bits="14" ids="On,Off"/>
        <dip name="Continue Play" bits="15" ids="No,Yes"/>
    </switches>

    <buttons names="Attack,Jump,-,Start,Coin,Pause" default="A,B,X,Y,Start,Select"/>

    <rom index="1">
        <part>00</part>
    </rom>

    <rom index="0" zip="snowbrosj.zip|snowbros.zip" md5="None">
        <!-- maincpu - starts at 0x0 -->
        <interleave output="16">
            <part name="snowbros.3" crc="3f504f9e" map="01"/>
            <part name="snowbros.2" crc="854b02bc" map="10"/>
        </interleave>

        <!-- gfx1 - starts at 0x40000 -->
        <part name="sbros-1.41" crc="16f06b3a"/>

        <!-- soundcpu - starts at 0xC0000 -->
        <part name="sbros-4.29" crc="e6eab4e4"/>
        <!-- Total 0xC8000 bytes - 800 kBytes -->
    </rom>
</misterromdescription>
