<misterromdescription>
    <name>Quiz &amp; Dragons: Capcom Quiz Game (USA 920701)</name>
    <setname>qad</setname>
    <rbf>qad_mister</rbf>
    <mameversion>0286</mameversion>
    <year>1992</year>
    <manufacturer>Capcom</manufacturer>
    <players>2</players>
    <joystick>none</joystick>
    <rotation>Horizontal</rotation>
    <region>USA</region>
    <platform>Capcom CP System Hardware</platform>
    <category>Quiz</category>
    <catver>Quiz / English</catver>

    <switches default="ff,f4,ff">
        <!-- DSWA -->
        <dip name="Coin 1" bits="0,2" ids="1C/1Cr,1C/2Cr,1C/3Cr,1C/4Cr,1C/6Cr,2C/1Cr,3C/1Cr,4C/1Cr" values="7,6,5,4,3,2,1,0"/>
        <dip name="Continue Coin" bits="6" ids="On,Off"/>
        <!-- DSWB -->
        <dip name="Diff. Level 1" bits="8,10" ids="0 (Easy),1,2,3,4 (Hard)" values="6,5,4,3,0"/>
        <dip name="Diff. Level 2" bits="11,12" ids="Low,Normal,High,Brilliant" values="3,2,1,0"/>
        <dip name="Initial Vitality" bits="13,15" ids="5,4,3,2,1" values="7,6,5,4,3"/>
        <!-- DSWC -->
        <dip name="Free Play" bits="18" ids="Free Play,Normal"/>
        <dip name="Screen Pause" bits="19" ids="Yes,No"/>
        <dip name="Screen Flip" bits="20" ids="Yes,No"/>
        <dip name="Demonstration Sound" bits="21" ids="No,Yes"/>
        <dip name="Continue" bits="22" ids="No,Yes"/>
        <dip name="Test Mode" bits="23" ids="Test Mode,Game Mode"/>
    </switches>

    <buttons names="Button 1,Button 2,Button 3,Button 4,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,R" count="6"/>

    <rom index="1">
        <part>00</part>
    </rom>

    <rom index="0" zip="qad.zip" md5="None" address="0x30000000">
        <!-- maincpu - starts at 0x000000 -->
        <interleave output="16">
            <part name="qdu_36a.12f" crc="de9c24a0" map="10"/>
            <part name="qdu_42a.12h" crc="cfe36f0c" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="qdu_37a.13f" crc="10d22320" map="10"/>
            <part name="qdu_43a.13h" crc="15e6beb9" map="01"/>
        </interleave>
        <part repeat="0x100000"> FF </part>

        <!-- audiocpu - starts at 0x180000 -->
        <part name="qd_23.13b" crc="cfb5264b"/>

        <!-- oki - starts at 0x190000 -->
        <part name="qdu_30.12c" crc="f190da84"/>
        <part name="qdu_31.13c" crc="b7583f73"/>

        <!-- gfx - starts at 0x1d0000 -->
        <interleave output="64">
            <part name="qd_09.4b" crc="8c3f9f44" map="00000001"/>
            <part name="qd_01.4a" crc="f688cf8f" map="00000010"/>
            <part name="qd_13.9b" crc="afbd551b" map="00000100"/>
            <part name="qd_05.9a" crc="c3db0910" map="00001000"/>
            <part name="qd_24.5e" crc="2f1bd0ec" map="00010000"/>
            <part name="qd_17.5c" crc="a812f9e2" map="00100000"/>
            <part name="qd_38.8h" crc="ccdddd1f" map="01000000"/>
            <part name="qd_32.8f" crc="a8d295d3" map="10000000"/>
        </interleave>
        <!-- Total 0x2d0000 bytes - 2880 kBytes -->
    </rom>

    <rom index="37" zip="coinopkey.zip" md5="None">
        <part name="coinop.key"/>
    </rom>
</misterromdescription>
