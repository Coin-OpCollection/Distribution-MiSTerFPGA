    <category>Platform</category>
    <catver>Platform / Fighter Scrolling</catver>
    <t_status>beta</t_status>

    <switches default="ff,7f">
        <dip name="Coin A" bits="0,2" ids="5 Coins/1 Credit,1 Coin/5 Credits,3 Coins/1 Credit,1 Coin/2 Credits,4 Coins/1 Credit,1 Coin/3 Credits,2 Coins/1 Credit,1 Coin/1 Credit"/>
        <dip name="Coin B" bits="3,4" ids="2 Coins/3 Credits,1 Coin/2 Credits,2 Coins/1 Credit,1 Coin/1 Credit"/>
        <dip name="Test Mode" bits="5" ids="On,Off"/>
        <dip name="Free Play" bits="7" ids="On,Off"/>
        <dip name="Cabinet" bits="8" ids="Cocktail,Upright"/>
        <dip name="Difficulty" bits="9,10" ids="Hardest,Hard,Normal,Easy"/>
        <dip name="Lives" bits="11,12" ids="4,3,2,1"/>
        <dip name="Extend" bits="13,14" ids="40k/80k,30k/60k,20k/40k,10k/20k"/>
        <dip name="Demo Sounds" bits="15" ids="On,Off"/>
    </switches>

    <buttons names="Sword,Magic,-,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,R" count="6"/>

