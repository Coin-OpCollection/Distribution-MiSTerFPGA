<misterromdescription>
    <name>Black Heart</name>
    <setname>blkheart</setname>
    <rbf>blkheart</rbf>
    <mameversion>0281</mameversion>
    <year>1991</year>
    <manufacturer>UPL</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Horizontal</rotation>
    <region>World</region>
    <platform>NMK16 Hardware</platform>
    <category>Shoot 'em Up</category>
    <catver>Shooter / Flying Horizontal</catver>
    <t_status>beta</t_status>

    <switches default="FF,FF">
        <!-- SW1 -->
        <dip name="Flip Screen" bits="0" ids="On,Off"/>
        <dip name="Service Mode" bits="1" ids="On,Off"/>
        <dip name="Difficulty" bits="2,3" ids="Hardest,Hard,Normal,Easy"/>
        <dip name="Lives" bits="6,7" ids="5,2,4,3"/>
        <!-- SW2 -->
        <dip name="Demo Sounds" bits="9" ids="Off,On"/>
        <dip name="Coin B" bits="10,12" ids="Free Play,1 Coin/4 Credits,3 Coins/1 Credit,1 Coin/2 Credits,4 Coins/1 Credit,1 Coin/3 Credits,2 Coins/1 Credit,1 Coin/1 Credit"/>
        <dip name="Coin A" bits="13,15" ids="Free Play,1 Coin/4 Credits,3 Coins/1 Credit,1 Coin/2 Credits,4 Coins/1 Credit,1 Coin/3 Credits,2 Coins/1 Credit,1 Coin/1 Credit"/>
    </switches>

    <buttons names="Energy Fire,Flame Breath,-,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,-" count="6"/>

    <rom index="1">
        <part>00</part>
    </rom>

    <rom index="0" zip="blkheart.zip|nmk004.zip" md5="None" address="0x30000000">
        <!-- maincpu - starts at 0x000000 -->
        <interleave output="16">
            <part name="blkhrt.7" crc="5bd248c0" map="10"/>
            <part name="blkhrt.6" crc="6449e50d" map="01"/>
        </interleave>

        <!-- nmk004 - starts at 0x040000 -->
        <part name="4.bin" crc="7cefa295"/>

        <!-- fgtile - starts at 0x050000 -->
        <part name="3.bin" crc="a1ab3a16"/>

        <!-- bgtile - starts at 0x070000 -->
        <part name="90068-5.bin" crc="a1ab4f24"/>

        <!-- sprites - starts at 0x170000 -->
        <part name="90068-8.bin" crc="9d3204b2"/>

        <!-- oki1 - starts at 0x270000 -->
        <part name="90068-2.bin" crc="3a583184"/>

        <!-- oki2 - starts at 0x2F0000 -->
        <part name="90068-1.bin" crc="e7af69d2"/>

        <!-- nmk_irq htiming - starts at 0x370000 -->
        <part name="10.bpr" crc="cfdbb86c"/>

        <!-- nmk_irq vtiming - starts at 0x370100 -->
        <part name="9.bpr" crc="98ed1c97"/>

        <!-- nmk004 internal - starts at 0x370200 -->
        <part name="nmk004.bin" crc="8ae61a09"/>
        <!-- Total 0x372200 bytes -->
    </rom>

    <rom index="37" zip="coinopkey.zip" md5="None">
        <part name="coinop.key"/>
    </rom>
</misterromdescription>
