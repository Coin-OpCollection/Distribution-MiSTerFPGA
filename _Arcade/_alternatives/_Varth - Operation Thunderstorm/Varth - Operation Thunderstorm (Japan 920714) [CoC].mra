<misterromdescription>
    <name>Varth: Operation Thunderstorm (Japan 920714)</name>
    <setname>varthj</setname>
    <rbf>varth_mister</rbf>
    <mameversion>0286</mameversion>
    <year>1992</year>
    <manufacturer>Capcom</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Vertical (CCW)</rotation>
    <region>Japan</region>
    <platform>Capcom CP System Hardware</platform>
    <category>Shooter</category>
    <catver>Shooter / Flying Vertical</catver>
    <t_status>beta</t_status>

    <switches default="ff,f4,bf">
        <!-- DSWA -->
        <dip name="Coin 1 Settings" bits="0,2" ids="1C/1Cr,1C/2Cr,1C/3Cr,1C/4Cr,1C/6Cr,2C/1Cr,3C/1Cr,4C/1Cr" values="7,6,5,4,3,2,1,0"/>
        <dip name="Coin 2 Settings" bits="3,5" ids="1C/1Cr,1C/2Cr,1C/3Cr,1C/4Cr,1C/6Cr,2C/1Cr,3C/1Cr,4C/1Cr" values="7,6,5,4,3,2,1,0"/>
        <dip name="Continue Coin" bits="6" ids="Continue Coin,Normal"/>
        <!-- DSWB -->
        <dip name="Difficulty Level" bits="8,10" ids="1 (Easy),2,3,4 (Normal),5,6,7,8 (Hard)" values="7,6,5,4,3,2,1,0"/>
        <dip name="Extend" bits="11,12" ids="600K Every 1400K,600K 2000K 4500K,1200K 3500K,2000K Only" values="3,2,1,0"/>
        <!-- DSWC -->
        <dip name="The Number of Player" bits="16,17" ids="1,2,3,4" values="2,1,3,0"/>
        <dip name="Free Play" bits="18" ids="Free Play,Normal"/>
        <dip name="Screen Pause" bits="19" ids="Yes,No"/>
        <dip name="Screen Flip" bits="20" ids="Yes,No"/>
        <dip name="Demonstration Sound" bits="21" ids="Yes,No"/>
        <dip name="Continue" bits="22" ids="Yes,No"/>
        <dip name="Test Mode" bits="23" ids="Test Mode,Game Mode"/>
    </switches>

    <buttons names="Shot,Bomb,-,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,R" count="6"/>

    <rom index="1">
        <part>03</part>
    </rom>

    <rom index="0" zip="varthj.zip|varth.zip" md5="None" address="0x30000000">
        <!-- maincpu - starts at 0x000000 -->
        <interleave output="16">
            <part name="vaj_36b.12f" crc="1d798d6a" map="10"/>
            <part name="vaj_42b.12h" crc="0f720233" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="vaj_37b.13f" crc="24414b17" map="10"/>
            <part name="vaj_43b.13h" crc="34b4b06c" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="vaj_34b.10f" crc="87c79aed" map="10"/>
            <part name="vaj_40b.10h" crc="210b4bd0" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="vaj_35b.11f" crc="6b0da69f" map="10"/>
            <part name="vaj_41b.11h" crc="6542c8a4" map="01"/>
        </interleave>
        <part repeat="0x80000"> FF </part>

        <!-- audiocpu - starts at 0x180000 -->
        <part name="va_23.13c" crc="7a99446e"/>

        <!-- oki - starts at 0x190000 -->
        <part name="va_30.12e" crc="de30510e"/>
        <part name="va_31.13e" crc="0610a4ac"/>

        <!-- gfx - starts at 0x1d0000 -->
        <interleave output="64">
            <part name="va_09.4b" crc="183dfaa8" map="00000001"/>
            <part name="va_01.4a" crc="c41312b5" map="00000010"/>
            <part name="va_13.9b" crc="45537e69" map="00000100"/>
            <part name="va_05.9a" crc="7065d4e9" map="00001000"/>
            <part name="va_24.5e" crc="57191ccf" map="00010000"/>
            <part name="va_17.5c" crc="054f5a5b" map="00100000"/>
            <part name="va_38.8h" crc="e117a17e" map="01000000"/>
            <part name="va_32.8f" crc="3b4f40b2" map="10000000"/>
        </interleave>
        <interleave output="64">
            <part name="va_10.5b"  crc="d62750cd" map="00000001"/>
            <part name="va_02.5a"  crc="11590325" map="00000010"/>
            <part name="va_14.10b" crc="dc2f4783" map="00000100"/>
            <part name="va_06.10a" crc="06e833ac" map="00001000"/>
            <part name="va_25.7e"  crc="51d90690" map="00010000"/>
            <part name="va_18.7c"  crc="a17817c0" map="00100000"/>
            <part name="va_39.9h"  crc="b0b12f51" map="01000000"/>
            <part name="va_33.9f"  crc="4b003af7" map="10000000"/>
        </interleave>
        <!-- Total 0x3d0000 bytes - 3904 kBytes -->
    </rom>

    <rom index="37" zip="coinopkey.zip" md5="None">
        <part name="coinop.key"/>
    </rom>
</misterromdescription>
