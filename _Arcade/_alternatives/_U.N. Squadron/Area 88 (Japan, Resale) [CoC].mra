<misterromdescription>
    <name>Area 88 (Japan, Resale)</name>
    <setname>area88r</setname>
    <rbf>unsquad_mister</rbf>
    <mameversion>0286</mameversion>
    <year>1989</year>
    <manufacturer>Capcom</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Horizontal</rotation>
    <region>Japan</region>
    <platform>Capcom CP System Hardware</platform>
    <category>Shooter</category>
    <catver>Shooter / Flying Horizontal</catver>

    <switches default="ff,fc,9f">
        <!-- DSWA -->
        <dip name="Coin A" bits="0,2" ids="2C/Start 1C/Cont,4C/1Cr,3C/1Cr,2C/1Cr,1C/4Cr,1C/3Cr,1C/2Cr,1C/1Cr"/>
        <dip name="Coin B" bits="3,5" ids="2C/Start 1C/Cont,4C/1Cr,3C/1Cr,2C/1Cr,1C/4Cr,1C/3Cr,1C/2Cr,1C/1Cr"/>
        <!-- DSWB -->
        <dip name="Diff." bits="8,10" ids="7 (Hardest),6,5,4,3 (Normal),2,1,0 (Easiest)"/>
        <dip name="Damage" bits="11,12" ids="Small,Normal,Big,Biggest" values="2,3,1,0"/>
        <!-- DSWC -->
        <dip name="Free Play" bits="18" ids="On,Off"/>
        <dip name="Freeze" bits="19" ids="On,Off"/>
        <dip name="Flip Screen" bits="20" ids="On,Off"/>
        <dip name="Demo Sound" bits="21" ids="On,Off"/>
        <dip name="Continue" bits="22" ids="Yes,No"/>
        <dip name="Test Mode" bits="23" ids="Test Mode,Game Mode"/>
    </switches>

    <buttons names="Shot,Special,-,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,R" count="6"/>

    <rom index="1">
        <part>02</part>
    </rom>

    <rom index="0" zip="area88r.zip|unsquad.zip" md5="None" address="0x30000000">
        <!-- maincpu - starts at 0x000000 -->
        <part name="araj_23.8f" crc="7045d6cb"/>
        <part name="araj_22.7f" crc="9913002e"/>

        <!-- audiocpu - starts at 0x100000 -->
        <part name="ara_09.12a" crc="af88359c" length="0x10000"/>

        <!-- oki - starts at 0x110000 -->
        <part name="ara_18.11c" crc="584b43a9"/>
        <part repeat="0x20000"> FF </part>

        <!-- gfx - starts at 0x150000 -->
        <interleave output="64">
            <part name="ara_01.3a" crc="bf4575d8" map="00000021"/>
            <part name="ara_02.4a" crc="a02945f4" map="00002100"/>
            <part name="ara_03.5a" crc="5965ca8d" map="00210000"/>
            <part name="ara_04.6a" crc="ac6db17d" map="21000000"/>
        </interleave>
        <!-- Total 0x350000 bytes - 3392 kBytes -->
    </rom>

    <rom index="37" zip="coinopkey.zip" md5="None">
        <part name="coinop.key"/>
    </rom>
</misterromdescription>
