<misterromdescription>
    <name>Street Fighter II: The World Warrior (Japan 911210, CPS-B-13)</name>
    <setname>sf2j</setname>
    <rbf>sf2_mister</rbf>
    <mameversion>0286</mameversion>
    <year>1991</year>
    <manufacturer>Capcom</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Horizontal</rotation>
    <region>Japan</region>
    <platform>Capcom CP System Hardware</platform>
    <category>Fighter</category>
    <catver>Fighter / Versus</catver>
    <t_status>beta</t_status>

    <switches default="bf,f4,9f">
        <!-- DSWA -->
        <dip name="Coin 1" bits="0,2" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/6Cr,1C/4Cr,1C/3Cr,1C/2Cr,1C/1Cr"/>
        <dip name="Coin 2" bits="3,5" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/6Cr,1C/4Cr,1C/3Cr,1C/2Cr,1C/1Cr"/>
        <dip name="Continue Coin" bits="6" ids="Continue Coin,Normal"/>
        <!-- DSWB -->
        <dip name="Difficulty" bits="8,10" ids="7 (Difficult),6,5,4,3 (Normal),2,1,0 (Easy)"/>
        <dip name="2P Game" bits="11" ids="2Cr/Winner Cont,1Cr/No Cont"/>
        <!-- DSWC -->
        <dip name="Free Play" bits="18" ids="Free Play,Not Free Play"/>
        <dip name="Screen Stop" bits="19" ids="Pause,Normal"/>
        <dip name="Screen Flip" bits="20" ids="Flip,Normal"/>
        <dip name="Demo Sound" bits="21" ids="On,Off"/>
        <dip name="Continue Mode" bits="22" ids="On,Off"/>
        <dip name="Test Mode" bits="23" ids="Test Mode,Game Mode"/>
    </switches>

    <buttons names="Jab Punch,Strong Punch,Fierce Punch,Short Kick,Forward Kick,Roundhouse Kick,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,-" count="6"/>

    <rom index="1">
        <part>12</part>
    </rom>

    <rom index="0" zip="sf2j.zip|sf2.zip" md5="None" address="0x30000000">
        <!-- maincpu - starts at 0x000000 -->
        <interleave output="16">
            <part name="sf2j30.bin" crc="79022b31" map="10"/>
            <part name="sf2j37.bin" crc="516776ec" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="sf2j31.bin" crc="fe15cb39" map="10"/>
            <part name="sf2j38.bin" crc="38614d70" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="sf2j28.bin" crc="d283187a" map="10"/>
            <part name="sf2j35.bin" crc="d28158e4" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="sf2_29a.bin" crc="bb4af315" map="10"/>
            <part name="sf2_36a.bin" crc="c02a13eb" map="01"/>
        </interleave>

        <!-- audiocpu - starts at 0x100000 -->
        <part name="sf2_09.bin" crc="a4823a1b"/>

        <!-- oki - starts at 0x110000 -->
        <part name="sf2_18.bin" crc="7f162009"/>
        <part name="sf2_19.bin" crc="beade53f"/>

        <!-- gfx - starts at 0x150000 -->
        <interleave output="64">
            <part name="sf2_06.8a"  crc="22c9cc8e" map="00000021"/>
            <part name="sf2_08.10a" crc="57213be8" map="00002100"/>
            <part name="sf2_05.7a"  crc="ba529b4f" map="00210000"/>
            <part name="sf2_07.9a"  crc="4b1b33a8" map="21000000"/>
        </interleave>
        <interleave output="64">
            <part name="sf2_15.8c"  crc="2c7e2229" map="00000021"/>
            <part name="sf2_17.10c" crc="b5548f17" map="00002100"/>
            <part name="sf2_14.7c"  crc="14b84312" map="00210000"/>
            <part name="sf2_16.9c"  crc="5e9cd89a" map="21000000"/>
        </interleave>
        <interleave output="64">
            <part name="sf2_25.8d"  crc="994bfa58" map="00000021"/>
            <part name="sf2_27.10d" crc="3e66ad9d" map="00002100"/>
            <part name="sf2_24.7d"  crc="c1befaa8" map="00210000"/>
            <part name="sf2_26.9d"  crc="0627c831" map="21000000"/>
        </interleave>
        <!-- Total 0x750000 bytes - 7488 kBytes -->
    </rom>

    <rom index="37" zip="coinopkey.zip" md5="None">
        <part name="coinop.key"/>
    </rom>
</misterromdescription>
