<misterromdescription>
    <name>Street Fighter II': Champion Edition (Japan 920803)</name>
    <setname>sf2cejc</setname>
    <rbf>sf2ce_mister</rbf>
    <mameversion>0286</mameversion>
    <year>1992</year>
    <manufacturer>Capcom</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Horizontal</rotation>
    <region>Japan</region>
    <platform>Capcom CP System Hardware</platform>
    <category>Fighter</category>
    <catver>Fighter / Versus</catver>
    <t_status>beta</t_status>

    <switches default="bf,fc,9f">
        <!-- DSWA -->
        <dip name="Coin 1" bits="0,2" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/6Cr,1C/4Cr,1C/3Cr,1C/2Cr,1C/1Cr"/>
        <dip name="Coin 2" bits="3,5" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/6Cr,1C/4Cr,1C/3Cr,1C/2Cr,1C/1Cr"/>
        <dip name="Continue Coin" bits="6" ids="Continue Coin,Normal"/>
        <!-- DSWB -->
        <dip name="Difficulty" bits="8,10" ids="7 (Difficult),6,5,4,3 (Normal),2,1,0 (Easy)"/>
        <dip name="2P Game" bits="11" ids="1Cr/No Cont,2Cr/Winner Cont"/>
        <!-- DSWC -->
        <dip name="Free Play" bits="18" ids="Free Play,Not Free Play"/>
        <dip name="Screen Stop" bits="19" ids="Pause,Normal"/>
        <dip name="Screen Flip" bits="20" ids="Flip,Normal"/>
        <dip name="Demo Sound" bits="21" ids="On,Off"/>
        <dip name="Continue Mode" bits="22" ids="On,Off"/>
        <dip name="Test Mode" bits="23" ids="Test Mode,Game Mode"/>
    </switches>

    <buttons names="Jab Punch,Strong Punch,Fierce Punch,Short Kick,Forward Kick,Roundhouse Kick,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,-" count="6"/>

    <rom index="1">
        <part>09</part>
    </rom>

    <rom index="0" zip="sf2cejc.zip|sf2ce.zip" md5="None" address="0x30000000">
        <!-- maincpu - starts at 0x000000 -->
        <part name="s92j_23c.8f" crc="f0120635"/>
        <part name="s92j_22c.7f" crc="8c0b2ed6"/>
        <part name="s92j_21a.6f" crc="925a7877"/>

        <!-- audiocpu - starts at 0x180000 -->
        <part name="s92_09.12a" crc="08f6b60e"/>

        <!-- oki - starts at 0x190000 -->
        <part name="s92_18.11c" crc="7f162009"/>
        <part name="s92_19.12c" crc="beade53f"/>

        <!-- gfx - starts at 0x1d0000 -->
        <interleave output="64">
            <part name="s92_01.3a" crc="03b0d852" map="00000021"/>
            <part name="s92_02.4a" crc="840289ec" map="00002100"/>
            <part name="s92_03.5a" crc="cdb5f027" map="00210000"/>
            <part name="s92_04.6a" crc="e2799472" map="21000000"/>
        </interleave>
        <interleave output="64">
            <part name="s92_05.7a"  crc="ba8a2761" map="00000021"/>
            <part name="s92_06.8a"  crc="e584bfb5" map="00002100"/>
            <part name="s92_07.9a"  crc="21e3f87d" map="00210000"/>
            <part name="s92_08.10a" crc="befc47df" map="21000000"/>
        </interleave>
        <interleave output="64">
            <part name="s92_10.3c" crc="960687d5" map="00000021"/>
            <part name="s92_11.4c" crc="978ecd18" map="00002100"/>
            <part name="s92_12.5c" crc="d6ec9a0a" map="00210000"/>
            <part name="s92_13.6c" crc="ed2c67f6" map="21000000"/>
        </interleave>
        <!-- Total 0x7d0000 bytes - 8000 kBytes -->
    </rom>

    <rom index="37" zip="coinopkey.zip" md5="None">
        <part name="coinop.key"/>
    </rom>
</misterromdescription>
