<misterromdescription>
    <name>Carrier Air Wing (USA 901130)</name>
    <setname>cawingu</setname>
    <rbf>cawing_mister</rbf>
    <mameversion>0286</mameversion>
    <year>1990</year>
    <manufacturer>Capcom</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Horizontal</rotation>
    <region>USA</region>
    <platform>Capcom CP System Hardware</platform>
    <category>Shooter</category>
    <catver>Shooter / Flying Horizontal</catver>
    <t_status>beta</t_status>

    <switches default="ff,fc,bf">
        <!-- DSWA -->
        <dip name="Coin 1" bits="0,2" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/6Cr,1C/4Cr,1C/3Cr,1C/2Cr,1C/1Cr"/>
        <dip name="Coin 2" bits="3,5" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/6Cr,1C/4Cr,1C/3Cr,1C/2Cr,1C/1Cr"/>
        <dip name="Continue" bits="6" ids="2C/Start 1C/Cont,Normal"/>
        <!-- DSWB -->
        <dip name="Difficulty 1" bits="8,10" ids="8 (Difficult),7,6,5,4 (Normal),3,2,1 (Easy)"/>
        <dip name="Difficulty 2" bits="11,12" ids="Very Difficult,Difficult,Easy,Normal"/>
        <!-- DSWC -->
        <dip name="Free Play" bits="18" ids="Free Play,Not Free Play"/>
        <dip name="Screen Stop" bits="19" ids="Pause,Normal"/>
        <dip name="Screen Flip" bits="20" ids="Flip,Normal"/>
        <dip name="Demo Sound" bits="21" ids="On,Off"/>
        <dip name="Continue Mode" bits="22" ids="On,Off"/>
        <dip name="Test Mode" bits="23" ids="Test Mode,Game Mode"/>
    </switches>

    <buttons names="Shot,Super Weapon,-,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,R" count="6"/>

    <rom index="1">
        <part>02</part>
    </rom>

    <rom index="0" zip="cawingu.zip|cawing.zip" md5="None" address="0x30000000">
        <!-- maincpu - starts at 0x000000 -->
        <interleave output="16">
            <part name="cau_36.12f" crc="c2574c0c" map="10"/>
            <part name="cau_42.12h" crc="d89e00be" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="cau_37.13f" crc="8e6d4f8a" map="10"/>
            <part name="cau_43.13h" crc="ece07955" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="cau_34.10f" crc="5fda906e" map="10"/>
            <part name="cau_40.10h" crc="736c1835" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="cau_35.11f" crc="74c2ddf0" map="10"/>
            <part name="cau_41.11h" crc="2a44bfe5" map="01"/>
        </interleave>

        <!-- audiocpu - starts at 0x100000 -->
        <part name="cau_23.13b" crc="96fe7485"/>

        <!-- oki - starts at 0x110000 -->
        <part name="cau_30.12c" crc="4a613a2c"/>
        <part name="cau_31.13c" crc="74584493"/>

        <!-- gfx - starts at 0x150000 -->
        <interleave output="64">
            <part name="cau_09.4b" crc="d4b17c3a" map="00000001"/>
            <part name="cau_01.4a" crc="34c3094e" map="00000010"/>
            <part name="cau_13.9b" crc="9d5c7911" map="00000100"/>
            <part name="cau_05.9a" crc="f042cc7b" map="00001000"/>
            <part name="cau_24.5e" crc="0eac450f" map="00010000"/>
            <part name="cau_17.5c" crc="4fab0d0c" map="00100000"/>
            <part name="cau_38.8h" crc="cb96ed24" map="01000000"/>
            <part name="cau_32.8f" crc="433a0859" map="10000000"/>
        </interleave>
        <interleave output="64">
            <part name="cau_10.5b"  crc="4af10ef2" map="00000001"/>
            <part name="cau_02.5a"  crc="3e1f5b34" map="00000010"/>
            <part name="cau_14.10b" crc="2bef78c4" map="00000100"/>
            <part name="cau_06.10a" crc="3777ede1" map="00001000"/>
            <part name="cau_25.7e"  crc="859ee531" map="00010000"/>
            <part name="cau_18.7c"  crc="4c52edf1" map="00100000"/>
            <part name="cau_39.9h"  crc="147be975" map="01000000"/>
            <part name="cau_33.9f"  crc="8560c130" map="10000000"/>
        </interleave>
        <!-- Total 0x350000 bytes - 3392 kBytes -->
    </rom>

    <rom index="37" zip="coinopkey.zip" md5="None">
        <part name="coinop.key"/>
    </rom>
</misterromdescription>
