<misterromdescription>
    <name>Forgotten Worlds (USA, B-Board 88618B-2, Rev. E)</name>
    <setname>forgottnue</setname>
    <rbf>forgottn_mister</rbf>
    <mameversion>0286</mameversion>
    <year>1988</year>
    <manufacturer>Capcom</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Horizontal</rotation>
    <region>USA</region>
    <platform>Capcom CP System Hardware</platform>
    <category>Shooter</category>
    <catver>Shooter / Flying Horizontal</catver>
    <t_status>beta</t_status>

    <switches default="ff,fc,ff">
        <!-- DSWA -->
        <dip name="Coin 1" bits="0,2" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/6Cr,1C/4Cr,1C/3Cr,1C/2Cr,1C/1Cr"/>
        <dip name="Coin 2" bits="3,5" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/6Cr,1C/4Cr,1C/3Cr,1C/2Cr,1C/1Cr"/>
        <dip name="Demo Sound" bits="6" ids="No,Yes"/>
        <dip name="Picture Flip" bits="7" ids="Req&apos;d,Not Req&apos;d"/>
        <!-- DSWB -->
        <dip name="Diff." bits="8,10" ids="Level 8 (Difficult),Level 7,Level 6,Level 5,Level 4 (Normal),Level 3,Level 2,Level 1 (Easy)"/>
        <dip name="Test Mode" bits="14" ids="On,Off"/>
        <dip name="Picture Stop" bits="15" ids="On,Off"/>
        <!-- DSWC: not set, every switch off -->
    </switches>

    <buttons names="Shot,Rotate Left,Rotate Right,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,R" count="6"/>

    <rom index="1">
        <part>03</part>
    </rom>

    <rom index="0" zip="forgottnue.zip|forgottn.zip" md5="None" address="0x30000000">
        <!-- maincpu - starts at 0x000000 -->
        <interleave output="16">
            <part name="lw11e.14f" crc="82656910" map="10"/>
            <part name="lw15e.14g" crc="fb1e2bd0" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="lw10e.13f" crc="3ce81dbe" map="10"/>
            <part name="lw14e.13g" crc="472eaad1" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="lw-07.13e" crc="fd252a26" map="21"/>
        </interleave>

        <!-- audiocpu - starts at 0x100000 -->
        <part name="lw_00.14a" crc="59df2a63"/>

        <!-- oki - starts at 0x110000 -->
        <part name="lw-03u.14c" crc="807d051f"/>
        <part name="lw-04u.13c" crc="e6cd098e"/>

        <!-- gfx - starts at 0x150000 -->
        <interleave output="64">
            <part name="lw-01.9d" crc="0318f298" map="00000021"/>
            <part name="lw-08.9f" crc="25a8e43c" map="00002100"/>
            <part name="lw-05.9e" crc="e4552fd7" map="00210000"/>
            <part name="lw-12.9g" crc="8e6a832b" map="21000000"/>
        </interleave>
        <interleave output="64">
            <part name="lw-02.12d" crc="43e6c5c8" map="00000021"/>
            <part name="lw-09.12f" crc="899cb4ad" map="00002100"/>
            <part name="lw-06.12e" crc="5b9edffc" map="00210000"/>
            <part name="lw-13.12g" crc="8e058ef5" map="21000000"/>
        </interleave>
        <!-- Total 0x550000 bytes - 5440 kBytes -->
    </rom>

    <rom index="37" zip="coinopkey.zip" md5="None">
        <part name="coinop.key"/>
    </rom>
</misterromdescription>
