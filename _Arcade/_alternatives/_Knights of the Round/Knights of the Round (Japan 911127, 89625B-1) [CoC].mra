<misterromdescription>
    <name>Knights of the Round (Japan 911127, 89625B-1)</name>
    <setname>knightsja</setname>
    <rbf>knights_mister</rbf>
    <mameversion>0286</mameversion>
    <year>1991</year>
    <manufacturer>Capcom</manufacturer>
    <players>3</players>
    <joystick>8-way</joystick>
    <rotation>Horizontal</rotation>
    <region>Japan</region>
    <platform>Capcom CP System Hardware</platform>
    <category>Beat &apos;Em Up</category>
    <catver>Fighter / 2.5D</catver>
    <t_status>beta</t_status>

    <switches default="ff,bc,bf">
        <!-- DSWA -->
        <dip name="Coin Settings" bits="0,2" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/6Cr,1C/4Cr,1C/3Cr,1C/2Cr,1C/1Cr"/>
        <dip name="Continue Coin" bits="6" ids="On,Off"/>
        <!-- DSWB -->
        <dip name="Diff. Level 1" bits="8,10" ids="8 (Hard),7,6,5,4 (Normal),3,2,1 (Easy)"/>
        <dip name="Diff. Level 2" bits="11,13" ids="1 (Easy),2,3,8 (Hard),7,6,5,4 (Normal)"/>
        <dip name="Coin Chute" bits="14" ids="1-Chute,3-Chute"/>
        <dip name="Player Mode" bits="15" ids="2P Mode,3P Mode"/>
        <!-- DSWC -->
        <dip name="Lives" bits="16,17" ids="1,4,3,2"/>
        <dip name="Free Play" bits="18" ids="On,Off"/>
        <dip name="Screen Pause" bits="19" ids="Yes,No"/>
        <dip name="Screen Flip" bits="20" ids="Yes,No"/>
        <dip name="Demo Sound" bits="21" ids="On,Off"/>
        <dip name="Continue" bits="22" ids="Yes,No"/>
        <dip name="Test Mode" bits="23" ids="Test Mode,Game Mode"/>
    </switches>

    <buttons names="Attack,Jump,-,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,R" count="6"/>

    <rom index="1">
        <part>03</part>
    </rom>

    <rom index="0" zip="knightsja.zip|knights.zip" md5="None" address="0x30000000">
        <!-- maincpu - starts at 0x000000 -->
        <interleave output="16">
            <part name="krj_36.12f" crc="ad3d1a8e" map="10"/>
            <part name="krj_42.12h" crc="e694a491" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="krj_37.13f" crc="85596094" map="10"/>
