<misterromdescription>
    <name>Super Burger Time (World, Set 2)</name>
    <setname>supbtimea</setname>
    <rbf>supbtime_mister</rbf>
    <mameversion>0281</mameversion>
    <year>1990</year>
    <manufacturer>Data East Corporation</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Horizontal</rotation>
    <region>World</region>
    <platform>DECO DE-0343-X Hardware</platform>
    <category>Platform</category>
    <catver>Platform / Run Jump</catver>

    <switches default="FE,FE">
        <!-- DSW1 -->
        <dip name="Control Panel" bits="0" ids="Cocktail,Upright"/>
        <dip name="Screen Rotation" bits="1" ids="Off,On"/>
        <dip name="Coin Right" bits="2,4" ids="3 Coins/1 Credit,1 Coin/4 Credits,1 Coin/6 Credits,1 Coin/2 Credits,2 Coins/1 Credit,3 Coins/1 Credit,1 Coin/5 Credits,1 Coin/1 Credit"/>
        <dip name="Coin Left" bits="5,7" ids="3 Coins/1 Credit,1 Coin/4 Credits,1 Coin/6 Credits,1 Coin/2 Credits,2 Coins/1 Credit,3 Coins/1 Credit,1 Coin/5 Credits,1 Coin/1 Credit"/>
        <!-- DSW2 -->
        <dip name="Attract Mode Sound" bits="8" ids="On,Off"/>
        <dip name="Continue Mode" bits="9" ids="No,Yes"/>
        <dip name="Game Difficulty" bits="12,13" ids="Hardest,Easy,Hard,Normal"/>
        <dip name="No. of Lives" bits="14,15" ids="2,4,1,3"/>
    </switches>

    <buttons names="Attack,Jump,-,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,-" count="6"/>

    <rom index="1">
        <part>01</part>
    </rom>

    <rom index="0" zip="supbtime.zip" md5="None" address="0x30000000">
        <!-- maincpu - starts at 0x000000 -->
        <interleave output="16">
            <part name="3.11f" crc="98b5f263" map="10"/>
            <part name="4.12f" crc="937e68b9" map="01"/>
        </interleave>

        <!-- audiocpu - starts at 0x040000 -->
        <part name="gc06.bin" crc="e0e6c0f4"/>

        <!-- oki - starts at 0x050000 -->
        <part name="gc05.bin" crc="2f2246ff"/>

        <!-- tiles - starts at 0x070000 -->
        <interleave output="32">
            <part name="mae02.bin" crc="a715cca0" map="0012" offset="0x00000" length="0x40000"/>
            <part name="mae02.bin" crc="a715cca0" map="1200" offset="0x40000" length="0x40000"/>
        </interleave>

        <!-- sprites - starts at 0x0F0000 -->
        <interleave output="32">
            <part name="mae00.bin" crc="30043094" map="0021"/>
            <part name="mae01.bin" crc="434af3fb" map="2100"/>
        </interleave>
        <!-- Total 0x1F0000 bytes -->
    </rom>
</misterromdescription>
