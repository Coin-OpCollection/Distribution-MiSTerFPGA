<misterromdescription>
    <name>Pang! 3 (Europe 950511)</name>
    <setname>pang3r1</setname>
    <rbf>pang3_mister</rbf>
    <mameversion>0286</mameversion>
    <year>1995</year>
    <manufacturer>Mitchell</manufacturer>
    <players>2</players>
    <joystick>4-way</joystick>
    <rotation>Horizontal</rotation>
    <region>Europe</region>
    <platform>Capcom CP System Hardware</platform>
    <category>Shooter</category>
    <catver>Shooter / Balloon Popping</catver>
    <t_status>beta</t_status>

    <buttons names="Shot,-,-,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,R" count="6"/>

    <rom index="1">
        <part>01</part>
    </rom>

    <nvram index="2" size="128"/>

    <rom index="0" zip="pang3r1.zip|pang3.zip" md5="None" address="0x30000000">
        <!-- maincpu - starts at 0x000000 -->
        <part name="pa3e_17.11l" crc="d7041d32"/>
        <part name="pa3e_16.10l" crc="1be9a483"/>
        <part repeat="0x80000"> FF </part>

        <!-- audiocpu - starts at 0x180000 -->
        <part name="pa3_11.11f" crc="cb1423a2" length="0x10000"/>

        <!-- oki - starts at 0x190000 -->
        <part name="pa3_05.10d" crc="73a10d5d"/>
        <part name="pa3_06.11d" crc="affa4f82"/>

        <!-- gfx - starts at 0x1d0000 -->
        <interleave output="64">
            <part name="pa3-01m.2c" crc="068a152c" map="00000021" offset="0x000000" length="0x100000"/>
            <part name="pa3-07m.2f" crc="3a4a619d" map="00002100" offset="0x000000" length="0x100000"/>
            <part name="pa3-01m.2c" crc="068a152c" map="00210000" offset="0x100000" length="0x100000"/>
            <part name="pa3-07m.2f" crc="3a4a619d" map="21000000" offset="0x100000" length="0x100000"/>
        </interleave>
        <!-- Total 0x5d0000 bytes - 5952 kBytes -->
    </rom>

    <rom index="37" zip="coinopkey.zip" md5="None">
        <part name="coinop.key"/>
    </rom>
</misterromdescription>
