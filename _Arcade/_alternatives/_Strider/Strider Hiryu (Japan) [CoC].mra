        <!-- audiocpu - starts at 0x100000 -->
        <part name="sth_23.13c" crc="2ed403bc"/>

        <!-- oki - starts at 0x110000 -->
        <part name="sth_30.12e" crc="4386bc80"/>
        <part name="sth_31.13e" crc="444536d7"/>

        <!-- gfx - starts at 0x150000 -->
