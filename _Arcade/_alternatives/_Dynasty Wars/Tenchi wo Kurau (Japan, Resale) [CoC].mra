<misterromdescription>
    <name>Tenchi wo Kurau (Japan, Resale)</name>
    <setname>dynwarjr</setname>
    <rbf>dynwar_mister</rbf>
    <mameversion>0286</mameversion>
    <year>1989</year>
    <manufacturer>Capcom</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Horizontal</rotation>
    <region>Japan</region>
    <platform>Capcom CP System Hardware</platform>
    <category>Beat &apos;Em Up</category>
    <catver>Fighter / 2.5D</catver>
    <t_status>beta</t_status>

    <switches default="ff,ff,ff">
        <!-- DSWA -->
        <dip name="Coin 1" bits="0,2" ids="2C/Start 1C/Cont,4C/1Cr,3C/1Cr,2C/1Cr,1C/4Cr,1C/3Cr,1C/2Cr,1C/1Cr"/>
        <dip name="Coin 2" bits="3,5" ids="2C/Start 1C/Cont,4C/1Cr,3C/1Cr,2C/1Cr,1C/4Cr,1C/3Cr,1C/2Cr,1C/1Cr"/>
        <dip name="Free Play" bits="7" ids="On,Off"/>
        <!-- DSWB -->
        <dip name="Diff." bits="8,10" ids="8 (Very Difficult),7,6,5,1 (Very Easy),2,3,4 (Normal)"/>
        <!-- DSWC -->
        <dip name="Freeze" bits="16" ids="On,Off"/>
        <dip name="Turbo Mode" bits="17" ids="On,Off"/>
        <dip name="Screen Flip" bits="20" ids="Flip,Normal"/>
        <dip name="Demo Sound" bits="21" ids="Without Sound,With Sound"/>
        <dip name="Continue" bits="22" ids="Without Continue,With Continue"/>
        <dip name="Test Mode" bits="23" ids="Test Mode,Game Mode"/>
    </switches>

    <buttons names="Left Attack,Right Attack,Tactics,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,R" count="6"/>

    <rom index="1">
        <part>03</part>
    </rom>

    <rom index="0" zip="dynwarjr.zip|dynwar.zip" md5="None" address="0x30000000">
        <!-- maincpu - starts at 0x000000 -->
        <interleave output="16">
            <part name="tk1j_23.8f" crc="088a3009" map="21"/>
        </interleave>
        <interleave output="16">
            <part name="tk1j_22.7f" crc="93654bcf" map="21"/>
        </interleave>

        <!-- audiocpu - starts at 0x100000 -->
        <part name="tk1_09.12a" crc="db77d899" length="0x10000"/>

        <!-- oki - starts at 0x110000 -->
        <part name="tk1_18.11c" crc="7e5f6cb4"/>
        <part name="tk1_19.12c" crc="4a30c737"/>

        <!-- gfx - starts at 0x150000 -->
        <interleave output="64">
            <part name="tk1_01.3a" crc="f64bb6a0" map="00000021"/>
            <part name="tk1_02.4a" crc="21fe6274" map="00002100"/>
            <part name="tk1_03.5a" crc="0bf228cb" map="00210000"/>
            <part name="tk1_04.6a" crc="1255dfb1" map="21000000"/>
        </interleave>
        <interleave output="64">
            <part name="tk1_05.7a"  crc="44f7661e" map="00000021"/>
            <part name="tk1_06.8a"  crc="a54c515d" map="00002100"/>
            <part name="tk1_07.9a"  crc="ca5c687c" map="00210000"/>
            <part name="tk1_08.10a" crc="f9fe6591" map="21000000"/>
        </interleave>
        <!-- Total 0x550000 bytes - 5440 kBytes -->
    </rom>

    <rom index="37" zip="coinopkey.zip" md5="None">
        <part name="coinop.key"/>
    </rom>
</misterromdescription>
