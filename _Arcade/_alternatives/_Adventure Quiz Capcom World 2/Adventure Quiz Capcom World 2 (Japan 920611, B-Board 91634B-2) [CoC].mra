<misterromdescription>
    <name>Adventure Quiz Capcom World 2 (Japan 920611, B-Board 91634B-2)</name>
    <setname>cworld2jb</setname>
    <rbf>cworld2j_mister</rbf>
    <mameversion>0286</mameversion>
    <year>1992</year>
    <manufacturer>Capcom</manufacturer>
    <players>2</players>
    <joystick>none</joystick>
    <rotation>Horizontal</rotation>
    <region>Japan</region>
    <platform>Capcom CP System Hardware</platform>
    <category>Quiz</category>
    <catver>Quiz / Japanese</catver>
    <t_status>beta</t_status>

    <switches default="ff,fe,df">
        <!-- DSWA -->
        <dip name="Coin" bits="0,2" ids="1C/1Cr,1C/2Cr,1C/3Cr,1C/4Cr,1C/6Cr,2C/1Cr,3C/1Cr,4C/1Cr" values="7,6,5,4,3,2,1,0"/>
        <dip name="Continue Coin" bits="6" ids="On,Off"/>
        <!-- DSWB -->
        <dip name="Game Level" bits="8,10" ids="0,1,2,3,4" values="6,5,4,3,2"/>
        <dip name="Extend" bits="11,12" ids="N,E,D" values="3,2,1"/>
        <dip name="Players Life" bits="13,15" ids="1,2,3,4,5" values="0,4,7,5,6"/>
        <!-- DSWC -->
        <dip name="Free Play" bits="18" ids="On,Off"/>
        <dip name="Stop" bits="19" ids="On,Off"/>
        <dip name="Flip" bits="20" ids="On,Off"/>
        <dip name="Demo Sound" bits="21" ids="On,Off"/>
        <dip name="Continue" bits="22" ids="No,Yes"/>
        <dip name="Test" bits="23" ids="On,Off"/>
    </switches>

    <buttons names="Button 1,Button 2,Button 3,Button 4,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,R" count="6"/>

    <rom index="1">
        <part>01</part>
    </rom>

    <rom index="0" zip="cworld2jb.zip|cworld2j.zip" md5="None" address="0x30000000">
        <!-- maincpu - starts at 0x000000 -->
        <part name="q5 - 23_91634b.8f" crc="709f577f"/>
        <part name="q5 - 22_91634b.7f" crc="93248458"/>
        <part repeat="0x80000"> FF </part>

        <!-- audiocpu - starts at 0x180000 -->
        <part name="q5 - 09_91634b.12a" crc="e14dc524"/>

        <!-- oki - starts at 0x190000 -->
        <part name="q5 - 18_91634b.11c" crc="d10c1b68"/>
        <part name="q5 - 19_91634b.12c" crc="7d17e496"/>

        <!-- gfx - starts at 0x1d0000 -->
        <interleave output="64">
            <part name="q5 - 01_91634b.3a" crc="09d0e7ce" map="00000021"/>
            <part name="q5 - 02_91634b.4a" crc="22e4ce9a" map="00002100"/>
            <part name="q5 - 03_91634b.5a" crc="f7b3aed6" map="00210000"/>
            <part name="q5 - 04_91634b.6a" crc="520c6c88" map="21000000"/>
        </interleave>
        <!-- Total 0x3d0000 bytes - 3904 kBytes -->
    </rom>

    <rom index="37" zip="coinopkey.zip" md5="None">
        <part name="coinop.key"/>
    </rom>
</misterromdescription>
