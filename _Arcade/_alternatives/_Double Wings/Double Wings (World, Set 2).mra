<misterromdescription>
    <name>Double Wings (World, alt)</name>
    <setname>dblewinga</setname>
    <rbf>dblewing</rbf>
    <mameversion>0281</mameversion>
    <year>1993</year>
    <manufacturer>Mitchell</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Vertical (CW)</rotation>
    <region>World</region>
    <platform>DECO DEC-22VO Hardware</platform>
    <category>Shoot &apos;Em Up</category>
    <catver>Shooter / Flying Vertical</catver>

    <switches default="FF,7F">
        <!-- DSW 1 -->
        <dip name="Coin Right" bits="0,2" ids="3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/6 Credits,1 Coin/5 Credits,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Coin Left" bits="3,5" ids="3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/6 Credits,1 Coin/5 Credits,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Screen Rotation" bits="6" ids="On,Off"/>
        <dip name="Region" bits="7" ids="Korea,Japan"/>
        <!-- DSW 2 -->
        <dip name="No. of Plane" bits="8,9" ids="5,2,1,3"/>
        <dip name="Game Difficulty" bits="10,11" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Bonus Plane" bits="12,13" ids="250,000 Only,Every 300,000,Every 100,000,Every 150,000"/>
        <dip name="Continue Mode" bits="14" ids="Off,On"/>
        <dip name="Attract Mode Sound" bits="15" ids="On,Off"/>
    </switches>

    <buttons names="Shot,Bomb,-,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,-" count="6"/>

    <rom index="1">
        <part>01</part>
    </rom>

    <rom index="0" zip="dblewinga.zip|dblewing.zip" md5="None" address="0x30000000">
        <!-- maincpu - starts at 0x000000 -->
        <interleave output="16">
            <part name="2.3d" crc="1e6b0653" map="01"/>
            <part name="1.5d" crc="4d537dc9" map="10"/>
        </interleave>

        <!-- audiocpu (Z80) - starts at 0x080000 -->
        <part name="kp_02-.10h" crc="def035fa"/>

        <!-- oki - starts at 0x090000 -->
        <part name="kp_03-.16h" crc="5d7f930d"/>
        <part name="kp_03-.16h" crc="5d7f930d"/>
        <part repeat="0x40000"> 00 </part>

        <!-- tiles - starts at 0x110000 -->
        <interleave output="32">
            <part name="mbe-02.8h" crc="5a6d3ac5" map="0012" offset="0x00000" length="0x80000"/>
            <part name="mbe-02.8h" crc="5a6d3ac5" map="1200" offset="0x80000" length="0x80000"/>
        </interleave>

        <!-- sprites - starts at 0x210000 -->
        <interleave output="32">
            <part name="mbe-00.14a" crc="e33f5c93" map="2100"/>
            <part name="mbe-01.16a" crc="ef452ad7" map="0021"/>
        </interleave>
        <!-- Total 0x410000 bytes -->
    </rom>
</misterromdescription>
