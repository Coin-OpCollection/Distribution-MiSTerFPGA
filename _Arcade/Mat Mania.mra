<misterromdescription>
    <name>Mat Mania</name>
    <setname>matmania</setname>
    <rbf>matmania</rbf>
    <mameversion>0283</mameversion>
    <year>1985</year>
    <manufacturer>Technos Japan (Taito America License)</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Vertical (CCW)</rotation>
    <region>US</region>
    <platform>Mat Mania Hardware</platform>
    <category>Sports</category>
    <catver>Sports / Wrestling</catver>

    <switches default="20,f0">
        <dip name="Coin A" bits="0,1" ids="1 Coin/1 Credit,1 Coin/2 Credits,1 Coin/3 Credits,2 Coins/1 Credit"/>
        <dip name="Coin B" bits="2,3" ids="1 Coin/1 Credit,1 Coin/2 Credits,1 Coin/3 Credits,2 Coins/1 Credit"/>
        <dip name="Demo Sounds" bits="4" ids="On,Off"/>
        <dip name="Cabinet" bits="5" ids="Cocktail,Upright"/>
        <dip name="Service Mode" bits="6" ids="Off,On"/>
        <dip name="Difficulty" bits="8,9" ids="Easy,Medium,Hard,Hardest"/>
        <dip name="Tournament Time" bits="10,11" ids="2:36,2:30,2:24,2:12"/>
    </switches>

    <buttons names="Punch,Kick,-,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,R" count="6"/>

    <rom index="1">
        <part>01</part>
    </rom>

    <rom index="0" zip="matmania.zip" md5="none">
        <!-- maincpu - starts at 0x0 -->
        <part name="k0-03" crc="314ab8a4"/>
        <part name="k1-03" crc="3b3c3f08"/>
        <part name="k2-03" crc="286c0917"/>

        <!-- audiocpu - starts at 0xC000 -->
        <part name="k4-0" crc="86dab489"/>
        <part name="k5-0" crc="4c41cdba"/>

        <!-- chars - starts at 0x14000 -->
        <part name="ku-02" crc="613c8698"/>
        <part name="kv-02" crc="274ce14b"/>
        <part name="kw-02" crc="7588a9c4"/>

        <!-- tiles - starts at 0x1A000 -->
        <part name="kt-02" crc="5d817c70"/>
        <part name="ks-02" crc="2e9f3ba0"/>
        <part name="kr-02" crc="b057d3e3"/>

        <!-- sprites - starts at 0x26000 -->
        <part name="k6-00" crc="294d0878"/>
        <part name="k7-00" crc="0908c2f5"/>
        <part name="k8-00" crc="ae8341e1"/>
        <part name="k9-00" crc="752ac2c6"/>
