<misterromdescription>
    <name>Nemo (World 901130)</name>
    <setname>nemo</setname>
    <rbf>nemo_mister</rbf>
    <mameversion>0286</mameversion>
    <year>1990</year>
    <manufacturer>Capcom</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Horizontal</rotation>
    <region>World</region>
    <platform>Capcom CP System Hardware</platform>
    <category>Platform</category>
    <catver>Platform / Run Jump</catver>

    <switches default="ff,fc,9f">
        <!-- DSWA -->
        <dip name="Coin A" bits="0,2" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/6Cr,1C/4Cr,1C/3Cr,1C/2Cr,1C/1Cr"/>
        <dip name="Coin B" bits="3,5" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/6Cr,1C/4Cr,1C/3Cr,1C/2Cr,1C/1Cr"/>
        <dip name="Continue Coin" bits="6" ids="On,Off"/>
        <!-- DSWB -->
        <dip name="Difficulty" bits="8,10" ids="8 (Hardest),7,6,5,4,3,2,1 (Easiest)"/>
        <dip name="Life Bar" bits="11,12" ids="Minimum,Maximum,Medium" values="0,1,3"/>
        <!-- DSWC -->
        <dip name="Lives" bits="16,17" ids="4,3,1,2"/>
        <dip name="Free Play" bits="18" ids="On,Off"/>
        <dip name="Freeze" bits="19" ids="On,Off"/>
        <dip name="Flip Screen" bits="20" ids="On,Off"/>
        <dip name="Demo Sound" bits="21" ids="On,Off"/>
        <dip name="Allow Continue" bits="22" ids="Yes,No"/>
        <dip name="Game Mode" bits="23" ids="Test,Game"/>
    </switches>

    <buttons names="Attack,Jump,-,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,R" count="6"/>

    <rom index="1">
        <part>00</part>
    </rom>

    <rom index="0" zip="nemo.zip" md5="None" address="0x30000000">
        <!-- maincpu - starts at 0x000000 -->
        <interleave output="16">
            <part name="nme_30a.11f" crc="d2c03e56" map="10"/>
            <part name="nme_35a.11h" crc="5fd31661" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="nme_31a.12f" crc="b2bd4f6f" map="10"/>
            <part name="nme_36a.12h" crc="ee9450e3" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="nm-32m.8h" crc="d6d1add3" map="21"/>
        </interleave>

        <!-- audiocpu - starts at 0x100000 -->
        <part name="nme_09.12b" crc="0f4b0581"/>

        <!-- oki - starts at 0x110000 -->
        <part name="nme_18.11c" crc="bab333d4"/>
        <part name="nme_19.12c" crc="2650a0a8"/>

        <!-- gfx - starts at 0x150000 -->
        <interleave output="64">
            <part name="nm-5m.7a" crc="487b8747" map="00000021"/>
            <part name="nm-7m.9a" crc="203dc8c6" map="00002100"/>
            <part name="nm-1m.3a" crc="9e878024" map="00210000"/>
            <part name="nm-3m.5a" crc="bb01e6b6" map="21000000"/>
        </interleave>
        <!-- Total 0x350000 bytes - 3392 kBytes -->
    </rom>

    <rom index="37" zip="coinopkey.zip" md5="None">
        <part name="coinop.key"/>
    </rom>
</misterromdescription>
