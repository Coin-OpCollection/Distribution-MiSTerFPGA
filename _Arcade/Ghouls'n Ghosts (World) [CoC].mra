<misterromdescription>
    <name>Ghouls&apos;n Ghosts (World)</name>
    <setname>ghouls</setname>
    <rbf>ghouls_mister</rbf>
    <mameversion>0286</mameversion>
    <year>1988</year>
    <manufacturer>Capcom</manufacturer>
    <players>2</players>
    <joystick>4-way</joystick>
    <rotation>Horizontal</rotation>
    <region>World</region>
    <platform>Capcom CP System Hardware</platform>
    <category>Platform</category>
    <catver>Platform / Run Jump</catver>
    <t_status>beta</t_status>

    <switches default="ff,fd,ff">
        <!-- DSWA -->
        <dip name="Coin 1" bits="0,2" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/6Cr,1C/4Cr,1C/3Cr,1C/2Cr,1C/1Cr"/>
        <dip name="Coin 2" bits="3,5" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/6Cr,1C/4Cr,1C/3Cr,1C/2Cr,1C/1Cr"/>
        <!-- DSWB -->
        <dip name="Diff." bits="8,10" ids="H (Very Difficult),G,F,E,A (Very Easy),B (Recommended),C,D (Normal)"/>
        <dip name="Extend" bits="12,13" ids="40K/70K/Every 80K,20K/50K/Every 70K,10K/30K/Every 30K,30K/60K/Every 70K"/>
        <!-- DSWC -->
        <dip name="Number of Player" bits="16,17" ids="6,5,4,3"/>
        <dip name="Screen" bits="20" ids="Flip,Normal"/>
        <dip name="Demo Sound" bits="21" ids="No,Yes"/>
        <dip name="Continue" bits="22" ids="No,Yes"/>
        <dip name="Test Mode" bits="23" ids="Test Mode,Game Mode"/>
    </switches>

    <buttons names="Attack,Jump,-,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,R" count="6"/>

    <rom index="1">
        <part>00</part>
    </rom>

    <rom index="0" zip="ghouls.zip" md5="None" address="0x30000000">
        <!-- maincpu - starts at 0x000000 -->
        <interleave output="16">
            <part name="dme_29.10h" crc="166a58a2" map="10"/>
            <part name="dme_30.10j" crc="7ac8407a" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="dme_27.9h" crc="f734b2be" map="10"/>
            <part name="dme_28.9j" crc="03d3e714" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="dm-17.7j" crc="3ea1b0f2" map="12"/>
        </interleave>

        <!-- audiocpu - starts at 0x100000 -->
        <part name="26.10a" crc="3692f6e5"/>

        <!-- oki - starts at 0x110000 -->
        <part repeat="0x40000"> FF </part>

        <!-- gfx - starts at 0x150000 -->
        <interleave output="64">
            <part name="dm-05.3a" crc="0ba9c0b0" map="00000021"/>
            <part name="dm-07.3f" crc="5d760ab9" map="00002100"/>
            <part name="dm-06.3c" crc="4ba90b59" map="00210000"/>
            <part name="dm-08.3g" crc="4bdee9de" map="21000000"/>
        </interleave>
        <interleave output="64">
            <part name="09.4a" crc="ae24bb19" map="00000001"/>
            <part name="18.7a" crc="d34e271a" map="00000010"/>
            <part name="13.4e" crc="3f70dd37" map="00000100"/>
            <part name="22.7e" crc="7e69e2e6" map="00001000"/>
            <part name="11.4c" crc="37c9b6c6" map="00010000"/>
            <part name="20.7c" crc="2f1345b4" map="00100000"/>
            <part name="15.4g" crc="3c2a212a" map="01000000"/>
            <part name="24.7g" crc="889aac05" map="10000000"/>
        </interleave>
        <interleave output="64">
            <part name="10.4b" crc="bcc0f28c" map="00000001"/>
            <part name="19.7b" crc="2a40166a" map="00000010"/>
            <part name="14.4f" crc="20f85c03" map="00000100"/>
            <part name="23.7f" crc="8426144b" map="00001000"/>
            <part name="12.4d" crc="da088d61" map="00010000"/>
            <part name="21.7d" crc="17e11df0" map="00100000"/>
            <part name="16.4h" crc="f187ba1c" map="01000000"/>
            <part name="25.7h" crc="29f79c78" map="10000000"/>
        </interleave>
        <!-- Total 0x450000 bytes - 4416 kBytes -->
    </rom>

    <rom index="37" zip="coinopkey.zip" md5="None">
        <part name="coinop.key"/>
    </rom>
</misterromdescription>
